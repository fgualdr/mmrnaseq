#!/usr/bin/env perl
use strict;
use warnings;

# Robust GTF/GFF-to-BED12 converter for RSeQC.
#
# Historical versions of this pipeline used a small converter that switched its
# attribute parser globally when it saw a ##gff-version header. Some valid GTF
# files retain GFF-style header lines while using GTF transcript_id attributes;
# that caused an empty BED12 file and consequently RSeQC to report zero usable
# reads. This implementation parses attributes per record and supports both GTF
# and GFF3 conventions.
#
# With --fasta, the converter also validates the annotation contig namespace
# against the exact reference FASTA and emits only compatible transcript models.
# This logic intentionally lives in Perl so the minimal Perl process container
# does not depend on comm/sort/cut/wc/head/tr being installed.

sub usage {
    return "Usage: gtf2bed [--fasta reference.fa[.gz]] <annotation.gtf|gff[.gz]>\n";
}

sub open_text {
    my ($path) = @_;
    my $fh;
    if ($path =~ /\.gz$/i) {
        open($fh, '-|', 'gzip', '-dc', $path) or die "Cannot read $path: $!\n";
    } else {
        open($fh, '<', $path) or die "Cannot read $path: $!\n";
    }
    return $fh;
}

my $fasta;
while (@ARGV && $ARGV[0] =~ /^--/) {
    my $opt = shift @ARGV;
    if ($opt eq '--fasta') {
        @ARGV or die usage();
        $fasta = shift @ARGV;
    } elsif ($opt eq '--help' || $opt eq '-h') {
        print usage();
        exit 0;
    } else {
        die "Unknown option: $opt\n" . usage();
    }
}

my $input = shift @ARGV or die usage();
die usage() if @ARGV;

my %fasta_contig;
if (defined $fasta) {
    my $ffh = open_text($fasta);
    while (my $line = <$ffh>) {
        next unless $line =~ /^>(\S+)/;
        $fasta_contig{$1} = 1;
    }
    close $ffh;
    die "gtf2bed: reference FASTA contains no sequence records: $fasta\n"
        unless keys %fasta_contig;
}

my $fh = open_text($input);

my %tx;
my $line_no = 0;
my $exon_rows = 0;
my $rows_without_tx = 0;
my $rows_bad_coord = 0;
my $rows_bad_strand = 0;

sub parse_attrs {
    my ($text) = @_;
    my %a;

    # GTF: key "value"; key2 "value2";
    while ($text =~ /(?:^|;\s*)\s*([^\s;=]+)\s+"([^"]*)"/g) {
        $a{$1} = $2 if !exists $a{$1};
    }

    # GFF3: key=value;key2=value2
    for my $item (split /;/, $text) {
        $item =~ s/^\s+|\s+$//g;
        next unless length $item;
        if ($item =~ /^([^=\s]+)=(.*)$/) {
            my ($k, $v) = ($1, $2);
            $v =~ s/^"|"$//g;
            $a{$k} = $v if !exists $a{$k};
        }
    }
    return %a;
}

sub clean_parent_id {
    my ($id) = @_;
    $id =~ s/^\s+|\s+$//g;
    $id =~ s/^(?:transcript|mRNA|rna)://i;
    return $id;
}

while (my $line = <$fh>) {
    $line_no++;
    next if $line =~ /^\s*#/;
    chomp $line;
    next unless length $line;

    my @f = split /\t/, $line, 9;
    next unless @f == 9;
    my ($chrom, undef, $feature, $start, $end, undef, $strand, undef, $attr_text) = @f;

    next unless $feature eq 'exon' || $feature eq 'miRNA';
    $exon_rows++;

    unless ($start =~ /^\d+$/ && $end =~ /^\d+$/ && $start >= 1 && $end >= $start) {
        $rows_bad_coord++;
        next;
    }
    unless ($strand eq '+' || $strand eq '-') {
        $rows_bad_strand++;
        next;
    }

    my %a = parse_attrs($attr_text);
    my @ids;
    if (defined $a{'transcript_id'} && length $a{'transcript_id'}) {
        @ids = ($a{'transcript_id'});
    } elsif (defined $a{'transcriptId'} && length $a{'transcriptId'}) {
        @ids = ($a{'transcriptId'});
    } elsif (defined $a{'Parent'} && length $a{'Parent'}) {
        @ids = map { clean_parent_id($_) } split /,/, $a{'Parent'};
    } elsif (defined $a{'transcript'} && length $a{'transcript'}) {
        @ids = ($a{'transcript'});
    }

    @ids = grep { defined $_ && length $_ } @ids;
    unless (@ids) {
        $rows_without_tx++;
        next;
    }

    for my $id (@ids) {
        my $entry = $tx{$id};
        if (!$entry) {
            $tx{$id} = {
                chrom  => $chrom,
                strand => $strand,
                exons  => [],
            };
            $entry = $tx{$id};
        }

        # A transcript ID spanning chromosomes/strands is malformed for BED12.
        next if $entry->{chrom} ne $chrom || $entry->{strand} ne $strand;
        push @{$entry->{exons}}, [$start + 0, $end + 0];
    }
}
close $fh;

my @records;
for my $id (keys %tx) {
    my $entry = $tx{$id};
    my %seen;
    my @exons = sort {
        $a->[0] <=> $b->[0] || $a->[1] <=> $b->[1]
    } grep {
        my $k = $_->[0] . ':' . $_->[1];
        !$seen{$k}++
    } @{$entry->{exons}};
    next unless @exons;

    my $chrom = $entry->{chrom};
    my $strand = $entry->{strand};
    my $start0 = $exons[0]->[0] - 1;
    my $end1 = $exons[-1]->[1];
    my @sizes  = map { $_->[1] - $_->[0] + 1 } @exons;
    my @starts = map { $_->[0] - 1 - $start0 } @exons;

    my $safe_id = $id;
    $safe_id =~ s/[\t\r\n ]+/_/g;

    push @records, [
        $chrom,
        $start0,
        $end1,
        $safe_id,
        0,
        $strand,
        $start0,
        $end1,
        0,
        scalar(@exons),
        join(',', @sizes) . ',',
        join(',', @starts) . ',',
    ];
}

@records = sort {
    $a->[0] cmp $b->[0] ||
    $a->[1] <=> $b->[1] ||
    $a->[2] <=> $b->[2] ||
    $a->[3] cmp $b->[3]
} @records;

if (!@records) {
    die "gtf2bed: produced 0 BED12 transcripts from $input " .
        "(exon_rows=$exon_rows, missing_transcript_id=$rows_without_tx, " .
        "bad_coordinates=$rows_bad_coord, bad_strand=$rows_bad_strand). " .
        "RSeQC requires stranded exon models with transcript_id (GTF) or Parent (GFF3).\n";
}

my $unfiltered_n = scalar(@records);
my %bed_contig = map { $_->[0] => 1 } @records;

if (defined $fasta) {
    my %compatible;
    for my $c (keys %bed_contig) {
        $compatible{$c} = 1 if exists $fasta_contig{$c};
    }

    if (!keys %compatible) {
        my @fasta_examples = (sort keys %fasta_contig)[0 .. ((keys(%fasta_contig) < 5) ? keys(%fasta_contig)-1 : 4)];
        my @bed_examples   = (sort keys %bed_contig)[0 .. ((keys(%bed_contig) < 5) ? keys(%bed_contig)-1 : 4)];
        die "gtf2bed: RSeQC BED12 and reference FASTA have zero contig-name overlap. " .
            "FASTA contigs=" . scalar(keys %fasta_contig) . "; BED contigs=" . scalar(keys %bed_contig) . ". " .
            "Example FASTA contigs=[" . join(',', @fasta_examples) . "]; " .
            "Example BED contigs=[" . join(',', @bed_examples) . "]. " .
            "Fix the GTF/GFF contig namespace (or provide a compatible --gene_bed); " .
            "do not infer strandedness from an incompatible annotation.\n";
    }

    @records = grep { exists $compatible{$_->[0]} } @records;
    die "gtf2bed: compatibility filtering removed every transcript model unexpectedly\n"
        unless @records;

    print STDERR "gtf2bed: reference compatibility kept " . scalar(@records) .
        " / $unfiltered_n transcript models on " . scalar(keys %compatible) .
        " compatible contigs (fasta_contigs=" . scalar(keys %fasta_contig) .
        ", bed_contigs=" . scalar(keys %bed_contig) . ")\n";
}

for my $rec (@records) {
    print join("\t", @$rec), "\n";
}

print STDERR "gtf2bed: wrote " . scalar(@records) . " BED12 transcript models from " .
    "$exon_rows exon/miRNA records; skipped missing_transcript_id=$rows_without_tx, " .
    "bad_coordinates=$rows_bad_coord, bad_strand=$rows_bad_strand\n";
